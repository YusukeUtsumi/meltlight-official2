---
import "../styles/global.css";
import "../styles/experience.css";
import "../styles/courtyard.css";
import "../styles/atmos.css";
import "../styles/flowgen.css";
import "../styles/web-experiences.css";
import "../styles/about-world.css";
import "../styles/contact-world.css";
const { title = "MeltLight" } = Astro.props;
const description = "Works, products and open specifications at the boundary of expression and systems. Experiential web design and development by Yusuke Utsumi.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080c14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://studio.meltlight.art/" />
    <link rel="canonical" href="https://studio.meltlight.art/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/cormorant-regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/manrope-regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/images/walk/entrance-portrait.webp" as="image" media="(max-aspect-ratio: 9/10)" />
    <link rel="preload" href="/images/walk/entrance-landscape.webp" as="image" media="(min-aspect-ratio: 9/10)" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org", "@type":"Person", name:"Yusuke Utsumi", jobTitle:"Conceptual Digital Artist", url:"https://studio.meltlight.art/", description})} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="MeltLight, back to top">MeltLight</a>
      <nav aria-label="Main navigation"><a href="#works">Works</a><a href="#commissions">Web experiences</a><a href="#about">About</a><a href="#contact">Contact <span class="link-stroke" aria-hidden="true"></span></a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="footer-bottom"><span>© 2026</span><a href="#top">Back to top ↑</a></div></footer>
    <button class="motion-toggle" type="button" aria-pressed="false" hidden><span class="motion-icon" aria-hidden="true">Ⅱ</span><span class="motion-label">Pause motion</span></button>
    <script>
      import { mountAtmos } from "../scripts/atmos/mount.js";
      import { mountCourtyard } from "../scripts/courtyard.js";
      mountCourtyard();
      mountAtmos();
    </script>
  </body>
</html>
