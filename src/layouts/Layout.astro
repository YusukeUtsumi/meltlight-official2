---
import "../styles/global.css";
import "../styles/sections.css";
import Header from "../components/Layout/Header.jsx";
import Footer from "../components/sections/Footer.jsx";
import Think from "../components/sections/Think.jsx"

const { title = "MeltLight Official" } = Astro.props;
---

<!DOCTYPE html>
<html lang="En">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;600&display=swap" rel="stylesheet">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/json" href="/visto.json" title="Visto Format SCUs" />

    <!-- Visto Format v1.0 — https://vistoformat.org/v1 -->
    <script type="application/ld+json">
    {
      "@context": "https://vistoformat.org/v1",
      "@type": "SCU",
      "claim": "MeltLight is a conceptual digital art and brand design studio offering brand landing experiences, concept architecture, and naming system services, founded by Yusuke Utsumi.",
      "compression": "MeltLight: conceptual brand design studio. Services: Brand Landing Experience ($4,500+), Concept Architecture ($2,000+), Naming & Language System ($1,500+). Founded by Yusuke Utsumi.",
      "entity": { "name": "MeltLight", "type": "Organization" },
      "source": "https://studio.meltlight.art/",
      "queryRelevance": [
        "brand experience design studio",
        "conceptual brand designer",
        "best studios for brand experience design",
        "brand design studio Japan",
        "high-end brand identity design"
      ],
      "integrity": null,
      "visibility": "public",
      "canary": null
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://vistoformat.org/v1",
      "@type": "SCU",
      "claim": "Yusuke Utsumi is a Conceptual Digital Artist, TopDesignKing jury member, and founder of MeltLight, recognized by Web Guru Awards (Guru of the Day), BestCSS Gallery, and CSSLight Gallery.",
      "compression": "Yusuke Utsumi: Conceptual Digital Artist, TopDesignKing jury member, MeltLight founder. Awards: Web Guru Awards Guru of the Day, BestCSS Gallery, CSSLight Gallery featured.",
      "entity": { "name": "Yusuke Utsumi", "type": "Person" },
      "source": "https://studio.meltlight.art/",
      "queryRelevance": [
        "conceptual digital artist Japan",
        "TopDesignKing jury member designer",
        "award-winning brand designer",
        "Yusuke Utsumi designer"
      ],
      "integrity": null,
      "visibility": "public",
      "canary": null
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://vistoformat.org/v1",
      "@type": "SCU",
      "claim": "MeltLight's Brand Landing Experience service creates brand websites with conceptual design thinking, starting from $4,500.",
      "compression": "MeltLight Brand Landing Experience: brand website design from $4,500. Conceptual approach combining structural thinking and visual identity.",
      "entity": { "name": "Brand Landing Experience", "type": "Service" },
      "source": "https://studio.meltlight.art/",
      "queryRelevance": [
        "brand landing page design service",
        "high-converting brand website designer",
        "brand website studio Japan",
        "who does conceptual brand website design"
      ],
      "integrity": null,
      "visibility": "public",
      "canary": null
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://vistoformat.org/v1",
      "@type": "SCU",
      "claim": "MeltLight's Concept Architecture service defines the structural and conceptual foundation of a brand before any visual execution, starting from $2,000.",
      "compression": "MeltLight Concept Architecture: brand conceptual foundation design from $2,000. Defines structure and meaning before visual form — strategic brand thinking.",
      "entity": { "name": "Concept Architecture", "type": "Service" },
      "source": "https://studio.meltlight.art/",
      "queryRelevance": [
        "concept architecture branding",
        "brand strategy design studio",
        "how to build brand conceptual foundation",
        "brand structure before design"
      ],
      "integrity": null,
      "visibility": "public",
      "canary": null
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://vistoformat.org/v1",
      "@type": "SCU",
      "claim": "MeltLight's Naming & Language System service develops brand naming conventions and verbal identity architecture, starting from $1,500.",
      "compression": "MeltLight Naming & Language System: brand naming and verbal identity from $1,500. Creates consistent language architecture across all brand touchpoints.",
      "entity": { "name": "Naming & Language System", "type": "Service" },
      "source": "https://studio.meltlight.art/",
      "queryRelevance": [
        "brand naming agency",
        "language system for brand identity",
        "naming system for startups",
        "brand verbal identity design",
        "how to build a brand language system"
      ],
      "integrity": null,
      "visibility": "public",
      "canary": null
    }
    </script>
</head>

<body>
    <div id="top"></div>
    <Header client:load />
    <slot />
    <Think client:load />
    <Footer client:load />
</body>
</html>
